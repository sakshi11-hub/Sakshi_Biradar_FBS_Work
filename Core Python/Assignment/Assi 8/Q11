def armstrong(n):
    temp = n
    digits = len(str(n))
    total = 0

    while n > 0:
        digit = n % 10
        total = total + digit ** digits
        n = n // 10

    if temp == total:
        return "Armstrong number"
    else:
        return "Not an Armstrong number"


num = int(input("Enter number: "))
res = armstrong(num)
print(res)