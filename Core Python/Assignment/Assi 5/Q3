n = int(input("Enter the number of passengers:"))
ticket_cost = float(input("Enter the cost of ticket:"))

total_amount = 0

for i in range(1, n+1):
    age = int(input("Enter age of passengers:"))

    if age < 12:
        amount = ticket_cost * 0.70
    elif age > 59:
        amount = ticket_cost * 0.50
    else:
        amount = ticket_cost

    print("Passenger", i, "Age", age)
    print("Ticket cost:", amount)    

    total_amount += amount

print("Total amount to be paid:", total_amount)