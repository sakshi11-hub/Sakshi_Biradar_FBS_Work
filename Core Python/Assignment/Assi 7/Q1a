for i in range(1,11):
    for j in range(1,11):
        if(i<=5):
            if(j == 7 - i or j == 5 + i):
                print("*", end =' ')
            else:
                print(' ', end =' ') 
        else:
            if(j == i-4 or j == 16 - i):
                print("*", end =' ')
            else:
                print(' ', end =' ') 
            

    print()           
    