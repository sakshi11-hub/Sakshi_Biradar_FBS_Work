num = int(input("Enter the number:"))

original = num
sum = 0

while(num > 0):
    d = num % 10
    num = num // 10
    
    fact = 1
    for i in range(1, d + 1):
        fact *= i

    sum += fact
    
if(sum == original):
    print("Number is strong number")
else:
    print("Number is not strong number")        